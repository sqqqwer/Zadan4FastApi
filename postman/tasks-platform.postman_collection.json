    },
    {
      "key": "task_deadline",
      "value": "",
      "type": "string",
      "description": "При первом запросе автоматически выставляется дата через 7 дней; можно изменить вручную."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('task_deadline')) {",
          "    pm.collectionVariables.set('task_deadline', new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Регистрация компании (один раз)",
      "description": "Новый тестовый аккаунт: check-account → вставить company_invite_token → sign-up → sign-up-complete. Если администратор уже есть, пропусти папку и заполни admin_email/admin_password.",
      "item": [
        {
          "name": "01 Проверить email и получить приглашение",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Новый UUID на каждый Send. Для повтора с тем же ключом замени {{$guid}} на фиксированный UUID."
              }
            ],
            "url": "{{auth_base_url}}/check-account/{{admin_email}}",
            "description": "После отправки возьми токен из письма или docker compose logs backend и вставь в company_invite_token. API возвращает null.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Подтвердить email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Новый UUID на каждый Send. Для повтора с тем же ключом замени {{$guid}} на фиксированный UUID."
              }
            ],
            "url": "{{auth_base_url}}/sign-up",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"{{admin_email}}\",\n  \"invite_token\": \"{{company_invite_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Создать компанию и администратора",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Новый UUID на каждый Send. Для повтора с тем же ключом замени {{$guid}} на фиксированный UUID."
              }
            ],
            "url": "{{auth_base_url}}/sign-up-complete",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"{{admin_email}}\",\n  \"pass\": \"{{admin_password}}\",\n  \"first_name\": \"Smoke\",\n  \"last_name\": \"Admin\",\n  \"company_name\": \"{{company_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('admin_user_id', data.user_id);",
                  "    pm.collectionVariables.set('company_id', data.company_id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
