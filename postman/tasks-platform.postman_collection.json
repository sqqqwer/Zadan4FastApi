{
  "info": {
    "name": "Tasks Platform — базовая проверка API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "37 запросов: по одному на каждую операцию текущего API. Отдельные URL auth/org/tasks для перехода к микросервисам. Порядок: регистрация (если нужна) → Auth → Org → Tasks → смена email (вручную) → очистка. Для приглашений компании и смены email нужны токены из письма или логов: полный автоматический Run all без пауз не предусмотрен. Подробности в README.md рядом с коллекцией."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "auth_base_url",
      "value": "http://localhost:8000/auth/api/v1",
      "type": "string",
      "description": "Адрес auth с префиксом API, без завершающего /."
    },
    {
      "key": "org_base_url",
      "value": "http://localhost:8000/org/api/v1",
      "type": "string",
      "description": "Адрес org с префиксом API, без завершающего /."
    },
    {
      "key": "tasks_base_url",
      "value": "http://localhost:8000/tasks/api/v1",
      "type": "string",
      "description": "Адрес tasks с префиксом API, без завершающего /."
    },
    {
      "key": "admin_email",
      "value": "smoke.admin@example.com",
      "type": "string",
      "description": "Email отдельного тестового администратора."
    },
    {
      "key": "admin_password",
      "value": "SmokeAdmin123!",
      "type": "string",
      "description": "Пример пароля для тестового аккаунта."
    },
    {
      "key": "company_name",
      "value": "Smoke Test Company",
