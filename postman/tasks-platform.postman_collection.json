    },
    {
      "key": "email_change_token",
      "value": "",
      "type": "string",
      "description": "Вставь токен из ссылки после email-change."
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "description": "Сохраняется после login и login-refresh."
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string",
      "description": "Сохраняется после login и login-refresh."
    },
    {
      "key": "admin_user_id",
      "value": "",
      "type": "string",
      "description": "Сохраняется после регистрации компании или GET users/me."
