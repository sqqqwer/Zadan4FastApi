# Docker Compose settings; dedicated PostgreSQL container.
POSTGRES_USER=tasks_user
POSTGRES_PASSWORD=change-me-tasks-db-password
POSTGRES_DB=tasks_db
DB_HOST=db_tasks
DB_PORT=5432

FRONTEND_URL=https://tasker.com

JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
JWT_ALGORITHM=RS256
JWT_ISSUER=auth-module
JWT_AUDIENCE=tasks-platform

IDEMPOTENCY_HMAC_SECRET=change-me-tasks-hmac-secret

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

AUTH_BASE_URL=http://auth:8000
AUTH_USERS_LOOKUP_PATH=/auth/api/v1/users/lookup
AUTH_HTTP_TIMEOUT=2
ALLOWED_HOSTS=["localhost","127.0.0.1","tasks"]
STATISTICS_ENDPOINT=http://metrics:8000/heartbeat
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=1
TRACING_ENABLED=true
TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
TRACING_SAMPLE_RATIO=1.0
TRACING_TIMEOUT_SECONDS=3.0
TRACING_EXCLUDED_URLS=/(health|ready|outbox|consumer-lag|metrics)/?$
